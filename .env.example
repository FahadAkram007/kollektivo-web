# Copy to .env.local. The Firebase web config is public (it only names the project); access is
# protected by the API, which checks every ID token.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kollektivo-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kollektivo-dev
NEXT_PUBLIC_FIREBASE_APP_ID=
